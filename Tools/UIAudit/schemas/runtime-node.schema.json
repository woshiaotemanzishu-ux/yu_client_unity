{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-audit.runtime-node.v1",
  "type": "object",
  "required": ["schema", "source", "path", "name", "visible", "interaction", "state"],
  "properties": {
    "schema": { "const": "ui-audit.runtime-node.v1" },
    "source": { "enum": ["loaded-view", "managed-view", "laya-stage", "unknown"] },
    "path": { "type": "string" },
    "name": { "type": "string" },
    "visible": { "type": "boolean" },
    "identity": {
      "type": "object",
      "required": ["ownerView", "runtimeName", "bindings"],
      "properties": {
        "ownerView": { "type": ["string", "null"] },
        "runtimeName": { "type": "string" },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "relation", "source"],
            "properties": {
              "ownerView": { "type": ["string", "null"] },
              "field": { "type": "string" },
              "runtimeName": { "type": "string" },
              "relation": { "const": "direct-reference" },
              "source": { "const": "view-instance-field" }
            }
          }
        }
      }
    }
  }
}
