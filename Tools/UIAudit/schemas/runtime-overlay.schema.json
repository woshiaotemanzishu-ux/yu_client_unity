{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-audit.runtime-overlay.v1",
  "type": "object",
  "required": ["schema", "id", "kind", "authority", "nodeStagePath", "active", "interactive"],
  "properties": {
    "schema": { "const": "ui-audit.runtime-overlay.v1" },
    "id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "minLength": 1 },
    "nodeStagePath": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
    "nodePath": { "type": "string" },
    "active": { "type": "boolean" },
    "interactive": { "type": "boolean" },
    "currentView": { "type": ["object", "null"] },
    "candidates": { "type": "array", "items": { "type": "object" } },
    "gate": { "type": ["object", "null"] },
    "node": { "type": ["object", "null"] }
  }
}
