{
  "route": "mainui.setting.complete",
  "prefab": "Assets/Prefabs/UI/Setting/SettingModule.prefab",
  "editable_prefab": true,
  "components": [
    {
      "identity": "SettingShieldItem",
      "owner": "Setting",
      "consumers": ["auto-pick:17", "auto-pick:18", "auto-pick:19", "shield:1", "shield:2", "shield:3", "shield:10", "shield:14", "shield:20", "shield:22", "shield:25", "shield:5", "shield:26"],
      "state_matrix": ["unchecked", "checked", "short-label", "long-label", "level<150 reject", "simple-mode confirm/cancel"],
      "implementation": "SettingShieldItem.SetData + baked instances under both ScrollRect contents"
    },
    {
      "identity": "WithBtnHSlider",
      "owner": "Common (read-only dependency)",
      "consumers": ["subtype6 same-screen", "subtype7 effects", "subtype9 SFX", "subtype12 music"],
      "state_matrix": ["min", "mid", "max", "drag", "minus", "plus", "close-batch-commit", "reopen"],
      "implementation": "SettingView.EnsureSlider -> BaseView.Show"
    },
    {
      "identity": "CustomHeadItem",
      "owner": "Common (read-only dependency)",
      "consumers": ["Setting top role head"],
      "state_matrix": ["empty/loading", "current role head", "dress head changed", "hide-before-load-complete"],
      "implementation": "SettingView.RefreshHeadIcon"
    },
    {
      "identity": "TipsManager.Confirm",
      "owner": "Common (read-only dependency)",
      "consumers": ["simple-mode guard", "restore-default", "change-role", "return-login", "flee", "repair"],
      "state_matrix": ["prompt", "cancel", "confirm", "modal block", "return to same parent"],
      "implementation": "SettingView.BindButtons / ToggleWithSimpleModeGuard"
    },
    {
      "identity": "LoginUserAgreementView",
      "owner": "Login (read-only dependency)",
      "consumers": ["agreement link", "privacy link"],
      "state_matrix": ["type1 agreement", "type2 privacy", "close/return"],
      "implementation": "LoginFlow.OpenAgreementDocument"
    },
    {
      "identity": "FashionFlow.OpenDress(DressView.HeadType)",
      "owner": "Fashion/Role (read-only dependency)",
      "consumers": ["change avatar"],
      "state_matrix": ["Setting closes", "target tab is Head", "return chain"],
      "implementation": "SettingView.change_head_btn"
    }
  ],
  "scroll_structures": [
    {"name":"_box_base_setting","shape":"ScrollRect -> Viewport(RectMask2D) -> Content(layout)"},
    {"name":"_list_pick","shape":"ScrollRect -> Viewport(RectMask2D) -> Content(GridLayoutGroup+ContentSizeFitter)"},
    {"name":"_list_shield","shape":"ScrollRect -> Viewport(RectMask2D) -> Content(GridLayoutGroup+ContentSizeFitter)"}
  ],
  "excluded_legacy_templates": [
    {"name":"SettingSubscriptionItem","reason":"Imported hidden template; current old SettingView defines Subs=3 but exposes no reachable subscription tab."},
    {"name":"SettingChangeHeadView","reason":"Historical module popup; authoritative reachable avatar action routes to function 203 / DressType.Head."}
  ]
}
